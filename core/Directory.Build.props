<Project>
  <!-- Inherit the repository-wide settings while Core is staged inside Proxytrace. The explicit
       import is required there: MSBuild stops at the nearest Directory.Build.props, so without it
       the root file would not apply.

       Conditional, because Core is meant to leave. In its own repository there is no file above,
       GetPathOfFileAbove returns empty, and an unconditional Import of "" fails the build with
       MSB4020 before a single project compiles — the extracted repository would not build at all.
       Everything the parent supplies that Core actually needs is defaulted below, so the two
       layouts behave identically. -->
  <PropertyGroup>
    <NordsteinCoreParentProps>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</NordsteinCoreParentProps>
  </PropertyGroup>
  <Import Project="$(NordsteinCoreParentProps)" Condition="'$(NordsteinCoreParentProps)' != ''" />

  <PropertyGroup>
    <!-- Defaults for the standalone case; no-ops when the parent already set them. -->
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">true</TreatWarningsAsErrors>
    <IncludeSourceRevisionInInformationalVersion Condition="'$(IncludeSourceRevisionInInformationalVersion)' == ''">false</IncludeSourceRevisionInInformationalVersion>

    <!-- Core versions independently of the product that consumes it: its version is the
         package contract, not Proxytrace's release number. The release pipeline passes
         -p:NordsteinCoreVersion=X.Y.Z; local builds identify as a prerelease so a hand-built
         package can never be mistaken for a published one. -->
    <NordsteinCoreVersion Condition="'$(NordsteinCoreVersion)' == ''">0.1.0-dev</NordsteinCoreVersion>
    <Version>$(NordsteinCoreVersion)</Version>

    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Nordstein Software</Authors>
    <Company>Nordstein Software</Company>
    <Product>Nordstein.Core</Product>
    <Copyright>Copyright © Nordstein Software</Copyright>
    <PackageProjectUrl>https://github.com/NordsteinSoftware/Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NordsteinSoftware/Core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Placeholder: Core inherits Proxytrace's licence until the terms for a shared,
         separately distributed library are settled. See PUBLISHING.md — this must be
         confirmed before the first publish, because a package licence cannot be recalled
         from consumers who already restored it. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- A consumer of a binary package has no source to read, so the XML docs are the API
         documentation. CS1591 (missing doc on a public member) is not worth failing a build
         over while the surface is still being shaped. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Debugging into a binary dependency is the single biggest cost of the package split.
         Symbols plus SourceLink (built into the SDK since .NET 8, no extra package) keep
         step-into working from the consuming product. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="" Visible="false" Condition="Exists('README.md')" />
  </ItemGroup>
</Project>
