<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      `clear` first so a machine-level source cannot silently supply a package this repo
      did not intend to restore.

      The Nordstein.Core packages are not published yet, so package mode is exercised
      against a locally packed feed passed per invocation rather than configured here
      (a missing local source directory makes restore fail for everyone):

          dotnet pack core/Nordstein.Core.sln -c Release -p:NordsteinCoreVersion=0.1.0-dev -o core/artifacts
          dotnet build Proxytrace.sln -p:UseLocalCore=false -p:NordsteinCoreVersion=0.1.0-dev \
              -p:RestoreAdditionalProjectSources=core/artifacts

      When Core is published for real, add that feed here.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
