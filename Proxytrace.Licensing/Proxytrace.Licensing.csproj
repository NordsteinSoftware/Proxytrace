<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <NordsteinCoreReference Include="Nordstein.Core.Licensing" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Autofac" Version="9.3.2" />
    </ItemGroup>

    <!-- Compile-time license public-key override: bakes the value into assembly metadata so
         Release images can trust a non-production key ONLY when built that way (e2e/perf). -->
    <ItemGroup Condition="'$(LicensePublicKey)' != ''">
        <AssemblyMetadata Include="LicensePublicKeyOverride" Value="$(LicensePublicKey)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Proxytrace.Licensing.Tests" />
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>

</Project>
